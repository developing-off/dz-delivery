{
    "name": "dz-delivery/sdk",
    "description": "Unified PHP SDK for Algerian delivery carriers (ZRExpress, Yalidine, Maystro, Ecotrack).",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/developing-off/dz-delivery",
    "support": {
        "issues": "https://github.com/developing-off/dz-delivery/issues",
        "source": "https://github.com/developing-off/dz-delivery-php",
        "docs": "https://github.com/developing-off/dz-delivery/blob/main/docs/guide-php.md"
    },
    "keywords": [
        "algeria",
        "delivery",
        "shipping",
        "zrexpress",
        "yalidine",
        "cod",
        "maystro",
        "ecotrack"
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "DzDelivery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DzDelivery\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
