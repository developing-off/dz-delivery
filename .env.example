# Copy this file to `.env` and fill in your own credentials.
# NEVER commit your real `.env` file.

# --- ZRExpress ---------------------------------------------------------------
# API key from your ZRExpress dashboard (sent as `X-Api-Key` header)
ZREXPRESS_API_KEY=your-zrexpress-api-key
# Tenant identifier (sent as `X-Tenant` header)
ZREXPRESS_TENANT=your-zrexpress-tenant

# --- Yalidine ----------------------------------------------------------------
# API ID from the Yalidine developer dashboard (sent as `X-API-ID` header)
YALIDINE_API_ID=your-yalidine-api-id
# API token from the Yalidine developer dashboard (sent as `X-API-TOKEN` header)
YALIDINE_API_TOKEN=your-yalidine-api-token
# Origin wilaya code (1–58) of your parcels — required by Yalidine (used by examples)
YALIDINE_FROM_WILAYA_ID=16

# --- Maystro Delivery --------------------------------------------------------
# Store token from your Maystro account (sent as `Authorization: Token <token>`)
MAYSTRO_API_TOKEN=

# --- Ecotrack (DHD, Conexlog, MSM Go, Packers, World Express, ...) ------------
# API token from your courier's Ecotrack dashboard (sent as `Authorization: Bearer <token>`)
ECOTRACK_TOKEN=
# Built-in courier key (dhd, conexlog, andersondelivery, msmgo, packers, rocketdelivery, worldexpress)...
ECOTRACK_COURIER=
# ...or the tenant URL instead (https only), e.g. https://yourcourier.ecotrack.dz
ECOTRACK_BASE_URL=
