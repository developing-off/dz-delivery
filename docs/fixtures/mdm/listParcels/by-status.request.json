[
  {
    "method": "POST",
    "path": "/api/v2/shipping/parcels/search",
    "headers": {
      "x-api-key": "test-api-key"
    },
    "body": {
      "filters": {
        "status": [
          "delivery-failed",
          "returning",
          "return-ready",
